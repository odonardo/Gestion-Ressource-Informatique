    total_incidents: 0,
    incidents_ouverts: 0,
    incidents_en_cours: 0,
    incidents_resolus: 0,
    
    alertes_actives: 0,
    alertes_critiques: 0,
    
    taux_disponibilite: 0,
  });
  
  const [lastUpdate] = useState(new Date());

  // Formater la devise en Ariary
  const formatCurrency = (amount) => {
    return new Intl.NumberFormat('fr-FR').format(amount) + ' Ar';
  };

