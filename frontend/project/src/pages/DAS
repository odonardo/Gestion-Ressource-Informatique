      materiels_fonctionnels: 5,
      materiels_en_panne: 2,
      materiels_maintenance: 1,
      materiels_par_service: {
        'Informatique': 4,
        'Secrétariat': 2,
        'Direction': 1,
        'Archives': 1
      },
      total_incidents: 6,
      incidents_ouverts: 2,
      incidents_en_cours: 1,
      incidents_resolus: 3,
      alertes_actives: 4,
      alertes_critiques: 1,
      taux_disponibilite: 62.5
    };

    setStats(demoData);
    
    // Essayer de charger les vraies données en arrière-plan sans bloquer
    setTimeout(() => {
      console.log('Chargement des données en arrière-plan...');
