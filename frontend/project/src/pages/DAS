        <StatCard
          title="Disponibilité"
          value={`${stats.taux_disponibilite}%`}
          icon={CheckCircle}
          color="green"
          subtitle="Taux de disponibilité"
        />
      </div>

      {/* Section Graphiques */}
      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
