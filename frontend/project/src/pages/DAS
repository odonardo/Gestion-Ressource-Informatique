              </div>
              <ArrowRight className="h-5 w-5 text-primary" />
            </div>
          </div>
        </Link>

        <Link to="/incidents" className="card bg-error/10 hover:bg-error/20 transition-colors hover:scale-[1.02]">
          <div className="card-body p-4">
            <div className="flex items-center justify-between">
              <div>
                <h3 className="font-bold text-error">Incidents</h3>
                <p className="text-sm opacity-70">{stats.incidents_ouverts} ouverts</p>
              </div>
              <ArrowRight className="h-5 w-5 text-error" />
            </div>
          </div>
        </Link>

        <Link to="/alertes" className="card bg-warning/10 hover:bg-warning/20 transition-colors hover:scale-[1.02]">
