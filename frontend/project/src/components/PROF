import React, { useState, useEffect } from 'react';
import { 
  X, User, Phone, Building, Calendar, Shield, Settings, 
  Briefcase, Mail, Lock, Eye, EyeOff, UserPlus, MapPin,
  Monitor, AlertCircle, CheckCircle, BriefcaseIcon
} from 'lucide-react';
import { ProfilUtilisateur, User as UserType } from '../types';

interface ProfilUtilisateurFormData {
  // Informations de base
  username: string;
  email: string;
  password: string;
  password_confirm: string;
  first_name: string;
  last_name: string;
  name: string;
  
  // Informations du profil
  departement: string;
  telephone: string;
  date_embauche: string;
  role: 'user' | 'technician' | 'secretary' | 'director' | 'admin';
}

interface ProfilUtilisateurFormProps {
  isOpen: boolean;
  onClose: () => void;
  onSubmit: (profilData: any) => void;
  profil?: ProfilUtilisateur;
  usersWithoutProfile?: UserType[];
}

const ProfilUtilisateurForm: React.FC<ProfilUtilisateurFormProps> = ({
  isOpen,
  onClose,
  onSubmit,
  profil,
  usersWithoutProfile = []
}) => {
  const DEPARTEMENTS = [
    'Direction',
    'Comptabilité',
    'Ressources Humaines',
    'Informatique',
    'Secrétariat',
    'Archives',
    'À définir'
  ];

  const ROLE_DESCRIPTIONS = {
    user: 'Accès basique - Consultation et signalement',
    technician: 'Gestion technique - Réparations et installations',
    secretary: 'Gestion administrative - Fournisseurs et documents',
    director: 'Vue globale - Tableaux de bord et rapports',
    admin: 'Accès complet - Administration du système'
  };

  const [formData, setFormData] = useState<ProfilUtilisateurFormData>({
    username: '',
    email: '',
    password: '',
    password_confirm: '',
    first_name: '',
    last_name: '',
    name: '',
    departement: '',
    telephone: '',
    date_embauche: new Date().toISOString().split('T')[0],
    role: 'user'
  });

  const [showPassword, setShowPassword] = useState(false);
  const [showConfirmPassword, setShowConfirmPassword] = useState(false);
  const [errors, setErrors] = useState<Record<string, string>>({});
  const [passwordStrength, setPasswordStrength] = useState(0);
  const [isNewUserMode, setIsNewUserMode] = useState(true); // true = création, false = utilisation existant

  // Réinitialiser le formulaire à l'ouverture
  useEffect(() => {
    if (profil) {
      // Mode édition
      const today = new Date().toISOString().split('T')[0];
      const user = profil.user;
      
      // Extraire prénom et nom depuis le nom complet
      const nameParts = user?.first_name ? user.first_name.split(' ') : [];
      const firstName = nameParts[0] || '';
      const lastName = nameParts.slice(1).join(' ') || '';
      const fullName = `${firstName} ${lastName}`.trim();
      
      setFormData({
        username: user?.username || '',
        email: user?.email || '',
        password: '', // Pas de mot de passe en édition
        password_confirm: '',
        first_name: firstName,
        last_name: lastName,
        name: fullName,
        departement: profil.departement || '',
        telephone: profil.telephone || '',
        date_embauche: profil.date_embauche ? 
          new Date(profil.date_embauche).toISOString().split('T')[0] : 
          today,
        role: profil.role || 'user'
      });
      
      setIsNewUserMode(false); // Mode édition = pas de création de nouvel utilisateur
    } else {
      // Mode création
      const today = new Date().toISOString().split('T')[0];
      setFormData({
        username: '',
        email: '',
        password: '',
        password_confirm: '',
        first_name: '',
        last_name: '',
        name: '',
        departement: '',
        telephone: '',
        date_embauche: today,
        role: 'user'
      });
      setIsNewUserMode(true);
    }
    setErrors({});
  }, [profil, isOpen]);

  // Mettre à jour le nom complet quand prénom ou nom change
  useEffect(() => {
    if (!profil) { // Seulement en mode création
      const fullName = `${formData.first_name} ${formData.last_name}`.trim();
      setFormData(prev => ({
        ...prev,
        name: fullName
      }));
    }
  }, [formData.first_name, formData.last_name, profil]);

  // Vérifier la force du mot de passe (seulement en création)
  useEffect(() => {
    if (formData.password && isNewUserMode && !profil) {
      let strength = 0;
      if (formData.password.length >= 8) strength += 1;
      if (/[A-Z]/.test(formData.password)) strength += 1;
      if (/[0-9]/.test(formData.password)) strength += 1;
      if (/[^A-Za-z0-9]/.test(formData.password)) strength += 1;
      setPasswordStrength(strength);
    } else {
      setPasswordStrength(0);
    }
  }, [formData.password, isNewUserMode, profil]);

  const validateForm = (): boolean => {
    const newErrors: Record<string, string> = {};

    if (isNewUserMode && !profil) {
      // Validation pour la création d'un nouvel utilisateur
      if (!formData.username.trim()) {
        newErrors.username = "Le nom d'utilisateur est requis";
      } else if (formData.username.length < 3) {
        newErrors.username = "Minimum 3 caractères";
      }

      if (!formData.email.trim()) {
        newErrors.email = "L'email est requis";
      } else if (!/\S+@\S+\.\S+/.test(formData.email)) {
        newErrors.email = "Email invalide";
      }

      if (!formData.password) {
        newErrors.password = "Le mot de passe est requis";
      } else if (formData.password.length < 6) {
        newErrors.password = "Minimum 6 caractères";
      }

      if (formData.password !== formData.password_confirm) {
        newErrors.password_confirm = "Les mots de passe ne correspondent pas";
      }

      if (!formData.name.trim()) {
        newErrors.name = "Le nom complet est requis";
      } else if (formData.name.length < 2) {
        newErrors.name = "Minimum 2 caractères";
      }
    } else {
      // Validation pour l'édition ou l'utilisation d'un utilisateur existant
      if (!profil && !isNewUserMode) {
        // Si mode "utilisateur existant" en création
        // Rien à valider ici car le select sera géré
      }
    }
    
    if (!formData.departement.trim()) {
      newErrors.departement = 'Le département est requis';
    }
    
    if (!formData.role) {
      newErrors.role = 'Le rôle est requis';
    }

    setErrors(newErrors);
    return Object.keys(newErrors).length === 0;
  };

  const handleChange = (e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement>) => {
    const { name, value } = e.target;
    
    if (name === 'role') {
      setFormData(prev => ({ 
        ...prev, 
        [name]: value as 'user' | 'technician' | 'secretary' | 'director' | 'admin'
      }));
    } else if (name === 'name' && !profil) {
      // Découper le nom complet en prénom et nom
      const nameParts = value.split(' ');
      const firstName = nameParts[0] || '';
      const lastName = nameParts.slice(1).join(' ') || '';
      
      setFormData(prev => ({ 
        ...prev, 
        [name]: value,
        first_name: firstName,
        last_name: lastName
      }));
    } else {
      setFormData(prev => ({ 
        ...prev, 
        [name]: value 
      }));
    }
    
    if (errors[name]) {
      setErrors(prev => ({ 
        ...prev, 
        [name]: '' 
      }));
    }
  };

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    
    if (!validateForm()) {
      return;
    }

    let submitData: any;
    
    if (profil) {
      // MODE ÉDITION
      submitData = {
        user: profil.user?.id,
        departement: formData.departement.trim(),
        telephone: formData.telephone.trim(),
        date_embauche: formData.date_embauche || null,
        role: formData.role,
        // En édition, on peut aussi mettre à jour certaines infos utilisateur
        first_name: formData.first_name.trim(),
        last_name: formData.last_name.trim(),
        email: formData.email.trim()
      };
      console.log('📤 Mode ÉDITION - Données:', submitData);
    } else if (isNewUserMode) {
      // MODE CRÉATION D'UN NOUVEL UTILISATEUR
      submitData = {
        username: formData.username.trim(),
        email: formData.email.trim(),
        password: formData.password,
        password_confirm: formData.password_confirm,
        name: formData.name.trim(),
        departement: formData.departement.trim(),
        telephone: formData.telephone.trim(),
        date_embauche: formData.date_embauche || null,
        role: formData.role
      };
      console.log('📤 Mode CRÉATION NOUVEAU - Données:', submitData);
    } else {
      // MODE AVEC UTILISATEUR EXISTANT (vous pouvez ajouter une liste déroulante si nécessaire)
      // Pour l'instant, on reste en mode création complet
      submitData = {
        username: formData.username.trim(),
        email: formData.email.trim(),
        password: formData.password,
        password_confirm: formData.password_confirm,
        name: formData.name.trim(),
        departement: formData.departement.trim(),
        telephone: formData.telephone.trim(),
        date_embauche: formData.date_embauche || null,
        role: formData.role
      };
      console.log('📤 Mode CRÉATION - Données:', submitData);
    }

    onSubmit(submitData);
  };

  const handleClose = () => {
    const today = new Date().toISOString().split('T')[0];
    setFormData({
      username: '',
      email: '',
      password: '',
      password_confirm: '',
      first_name: '',
      last_name: '',
      name: '',
      departement: '',
      telephone: '',
      date_embauche: today,
      role: 'user'
    });
    setErrors({});
    onClose();
  };

  const getPasswordStrengthColor = () => {
    if (passwordStrength === 0) return 'bg-gray-300';
    if (passwordStrength === 1) return 'bg-red-500';
    if (passwordStrength === 2) return 'bg-yellow-500';
    if (passwordStrength === 3) return 'bg-blue-500';
    return 'bg-green-500';
  };

  const getPasswordStrengthText = () => {
    if (passwordStrength === 0) return 'Non renseigné';
    if (passwordStrength === 1) return 'Très faible';
    if (passwordStrength === 2) return 'Faible';
    if (passwordStrength === 3) return 'Moyen';
    return 'Fort';
  };

  const getRoleIcon = (role: string) => {
    switch (role) {
      case 'admin': return <Shield className="h-4 w-4" />;
      case 'technician': return <Settings className="h-4 w-4" />;
      case 'director': return <Briefcase className="h-4 w-4" />;
      case 'secretary': return <User className="h-4 w-4" />;
      default: return <User className="h-4 w-4" />;
    }
  };

  if (!isOpen) return null;

  return (
    <div className="fixed inset-0 bg-black bg-opacity-70 flex items-center justify-center z-50 p-4 overflow-y-auto">
      <div className="bg-base-100 rounded-xl shadow-2xl w-full max-w-4xl max-h-[90vh] overflow-y-auto">
        {/* En-tête avec logo DREN */}
        <div className="bg-gradient-to-r from-blue-900 to-blue-700 text-white rounded-t-xl p-6">
          <div className="flex justify-between items-start">
            <div>
              <div className="flex items-center gap-3 mb-2">
                <div className="bg-white p-2 rounded-full">
                  <UserPlus className="h-8 w-8 text-blue-600" />
                </div>
                <div>
                  <div className="flex items-center text-sm font-medium text-blue-200">
                    <MapPin className="h-4 w-4 mr-1" />
                    Toliara, Madagascar
                  </div>
                  <h2 className="text-2xl font-bold mt-1">
                    DREN Antsimo Andrefana
                  </h2>
                </div>
              </div>
              <p className="text-blue-200 text-sm">
                {profil 
                  ? `✏️ Modification du profil de @${profil.user?.username}`
                  : '👤 Création d\'un nouvel utilisateur et profil'}
              </p>
            </div>
            <button
              onClick={handleClose}
              className="btn btn-ghost btn-circle text-white hover:bg-white/20"
            >
              <X className="w-6 h-6" />
            </button>
          </div>
        </div>

        <form onSubmit={handleSubmit} className="p-6 space-y-6">
          {/* Informations personnelles */}
          <div className="space-y-4">
            <div className="flex items-center gap-2 mb-2">
              <User className="h-5 w-5 text-primary" />
              <h3 className="text-lg font-semibold text-base-content">
                Informations personnelles
              </h3>
            </div>

            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div className="form-control">
                <label className="label">
                  <span className="label-text font-medium text-base-content">
                    Nom complet *
                  </span>
                </label>
                <div className="relative">
                  <User className="absolute left-3 top-3 h-5 w-5 text-base-content opacity-70" />
                  <input
                    type="text"
                    name="name"
                    value={formData.name}
                    onChange={handleChange}
                    className={`input input-bordered w-full pl-10 bg-base-200 text-base-content ${
                      errors.name ? 'input-error' : ''
                    }`}
                    placeholder="Ex: Jean Dupont"
                    disabled={!!profil} // En édition, on ne modifie pas le nom complet
                  />
                </div>
                {errors.name && (
                  <div className="text-error text-sm mt-1">{errors.name}</div>
                )}
              </div>

              <div className="form-control">
                <label className="label">
                  <span className="label-text font-medium text-base-content">
                    Nom d'utilisateur *
                  </span>
                </label>
                <div className="relative">
                  <User className="absolute left-3 top-3 h-5 w-5 text-base-content opacity-70" />
                  <input
                    type="text"
                    name="username"
                    value={formData.username}
                    onChange={handleChange}
                    className={`input input-bordered w-full pl-10 bg-base-200 text-base-content ${
                      errors.username ? 'input-error' : ''
                    }`}
                    placeholder="Ex: j.dupont"
                    disabled={!!profil} // En édition, on ne modifie pas le username
                  />
                </div>
                {errors.username && (
                  <div className="text-error text-sm mt-1">{errors.username}</div>
