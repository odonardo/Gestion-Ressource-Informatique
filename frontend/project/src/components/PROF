                        <EyeOff className="h-5 w-5 text-base-content opacity-70" />
                      ) : (
                        <Eye className="h-5 w-5 text-base-content opacity-70" />
                      )}
                    </button>
                  </div>
                  {errors.password && (
                    <div className="text-error text-sm mt-1">{errors.password}</div>
                  )}
                  
                  {formData.password && (
                    <div className="mt-2">
                      <div className="flex justify-between items-center mb-1">
                        <span className="text-xs font-medium text-base-content">
                          Force du mot de passe: {getPasswordStrengthText()}
                        </span>
                        <span className="text-xs font-bold text-base-content">
                          {passwordStrength}/4
                        </span>
                      </div>
                      <div className="flex gap-1">
                        {[1, 2, 3, 4].map((level) => (
                          <div
                            key={level}
                            className={`h-2 flex-1 rounded ${
                              level <= passwordStrength
                                ? getPasswordStrengthColor()
                                : 'bg-base-300'
                            }`}
                          />
                        ))}
                      </div>
                    </div>
                  )}
                </div>

                <div className="form-control">
                  <label className="label">
                    <span className="label-text font-medium text-base-content">
                      Confirmer le mot de passe *
                    </span>
                  </label>
                  <div className="relative">
                    <Lock className="absolute left-3 top-3 h-5 w-5 text-base-content opacity-70" />
                    <input
                      type={showConfirmPassword ? "text" : "password"}
                      name="password_confirm"
                      value={formData.password_confirm}
                      onChange={handleChange}
                      className={`input input-bordered w-full pl-10 pr-10 bg-base-200 text-base-content ${
                        errors.password_confirm ? 'input-error' : ''
                      }`}
                      placeholder="Retapez votre mot de passe"
                    />
                    <button
                      type="button"
                      className="absolute right-3 top-3"
                      onClick={() => setShowConfirmPassword(!showConfirmPassword)}
                    >
                      {showConfirmPassword ? (
                        <EyeOff className="h-5 w-5 text-base-content opacity-70" />
                      ) : (
                        <Eye className="h-5 w-5 text-base-content opacity-70" />
                      )}
                    </button>
                  </div>
                  {errors.password_confirm && (
                    <div className="text-error text-sm mt-1">{errors.password_confirm}</div>
                  )}
                </div>
              </div>
            )}
          </div>

          {/* Informations professionnelles */}
          <div className="space-y-4">
            <div className="flex items-center gap-2 mb-2">
              <Briefcase className="h-5 w-5 text-primary" />
              <h3 className="text-lg font-semibold text-base-content">
                Informations professionnelles
              </h3>
            </div>

            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              {/* Département */}
              <div className="form-control">
                <label className="label">
                  <span className="label-text font-medium text-base-content">
                    Département *
                  </span>
                </label>
                <div className="relative">
                  <Building className="absolute left-3 top-3 h-5 w-5 text-base-content opacity-70" />
                  <select
                    name="departement"
                    value={formData.departement}
                    onChange={handleChange}
                    className={`select select-bordered w-full pl-10 bg-base-200 text-base-content ${
                      errors.departement ? 'select-error' : ''
                    }`}
                    required
                  >
                    <option value="">Sélectionnez un département</option>
                    {DEPARTEMENTS.map(dept => (
                      <option key={dept} value={dept} className="text-base-content">
                        {dept}
                      </option>
                    ))}
                  </select>
                </div>
                {errors.departement && (
                  <div className="text-error text-sm mt-1">{errors.departement}</div>
                )}
              </div>

              {/* Rôle */}
              <div className="form-control">
                <label className="label">
                  <span className="label-text font-medium text-base-content">
                    Rôle *
                  </span>
                </label>
                <div className="relative">
                  <Shield className="absolute left-3 top-3 h-5 w-5 text-base-content opacity-70" />
                  <select
                    name="role"
                    value={formData.role}
                    onChange={handleChange}
                    className={`select select-bordered w-full pl-10 bg-base-200 text-base-content ${
                      errors.role ? 'select-error' : ''
                    }`}
                    required
                  >
                    <option value="">Sélectionnez un rôle</option>
                    <option value="user" className="text-base-content">Utilisateur standard</option>
                    <option value="technician" className="text-base-content">Technicien</option>
                    <option value="secretary" className="text-base-content">Secrétaire</option>
                    <option value="director" className="text-base-content">Directeur</option>
                    <option value="admin" className="text-base-content">Administrateur</option>
                  </select>
                </div>
                {formData.role && (
                  <div className="mt-2 p-3 bg-primary/10 rounded-lg border border-primary/20">
                    <div className="flex items-center text-sm">
                      <div className="p-1 rounded bg-primary/20 mr-2">
                        {getRoleIcon(formData.role)}
                      </div>
                      <span className="font-medium text-primary">
                        {ROLE_DESCRIPTIONS[formData.role]}
                      </span>
                    </div>
                  </div>
                )}
                {errors.role && (
                  <div className="text-error text-sm mt-1">{errors.role}</div>
                )}
              </div>
            </div>

            {/* Date d'embauche */}
            <div className="form-control">
              <label className="label">
                <span className="label-text font-medium text-base-content">
                  Date d'embauche
                </span>
              </label>
              <div className="relative">
                <Calendar className="absolute left-3 top-3 h-5 w-5 text-base-content opacity-70" />
                <input
                  type="date"
                  name="date_embauche"
                  value={formData.date_embauche}
                  onChange={handleChange}
                  className="input input-bordered w-full pl-10 bg-base-200 text-base-content"
                />
              </div>
            </div>
          </div>

          {/* Aperçu du profil */}
          <div className="card bg-base-200 border-2 border-base-300">
            <div className="card-body p-4">
              <div className="flex items-center gap-2 mb-3">
                <div className="p-1 rounded bg-primary/20">
                  <User className="h-5 w-5 text-primary" />
                </div>
                <h3 className="card-title text-base font-semibold text-base-content">
                  Aperçu du profil
                </h3>
              </div>
              
              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 text-sm">
                <div className="flex justify-between items-center p-3 bg-base-100 rounded-lg border border-base-300">
                  <span className="font-medium text-base-content">Type:</span>
                  <span className="font-semibold text-primary">
                    {profil ? 'Édition' : 'Nouvel utilisateur'}
                  </span>
                </div>
                
                {!profil && (
                  <>
                    <div className="flex justify-between items-center p-3 bg-base-100 rounded-lg border border-base-300">
                      <span className="font-medium text-base-content">Username:</span>
                      <span className="font-semibold text-primary">
                        {formData.username || 'Non défini'}
                      </span>
                    </div>
                    <div className="flex justify-between items-center p-3 bg-base-100 rounded-lg border border-base-300">
                      <span className="font-medium text-base-content">Email:</span>
                      <span className="font-semibold text-primary">
                        {formData.email || 'Non défini'}
                      </span>
                    </div>
                  </>
                )}
                
                <div className="flex justify-between items-center p-3 bg-base-100 rounded-lg border border-base-300">
                  <span className="font-medium text-base-content">Département:</span>
                  <span className="badge badge-primary badge-lg">
                    {formData.departement || 'Non sélectionné'}
                  </span>
                </div>
                
                <div className="flex justify-between items-center p-3 bg-base-100 rounded-lg border border-base-300">
                  <span className="font-medium text-base-content">Rôle:</span>
                  <span className={`badge ${
                    formData.role === 'admin' ? 'badge-error' :
                    formData.role === 'director' ? 'badge-warning' :
                    formData.role === 'technician' ? 'badge-primary' :
                    formData.role === 'secretary' ? 'badge-info' :
                    'badge-neutral'
                  } badge-lg`}>
                    {formData.role === 'user' ? 'Utilisateur' :
                     formData.role === 'technician' ? 'Technicien' :
                     formData.role === 'secretary' ? 'Secrétaire' :
                     formData.role === 'director' ? 'Directeur' : 'Administrateur'}
                  </span>
                </div>
                
                <div className="flex justify-between items-center p-3 bg-base-100 rounded-lg border border-base-300 md:col-span-2 lg:col-span-1">
                  <span className="font-medium text-base-content">Nom complet:</span>
                  <span className="font-semibold text-primary">
                    {formData.name || 'Non défini'}
                  </span>
                </div>
              </div>
            </div>
          </div>

          {/* Informations sur les rôles */}
          <div className="bg-base-200 rounded-lg p-4 border border-base-300">
            <h3 className="text-base font-semibold text-base-content mb-3">📋 Informations sur les rôles</h3>
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 text-sm">
              <div className="bg-blue-50 p-3 rounded-lg border border-blue-100">
                <div className="flex items-center font-semibold text-blue-700 mb-1">
                  <User className="h-4 w-4 mr-2" />
                  Utilisateur Standard
                </div>
                <p className="text-blue-600">Consultation et signalement d'incidents</p>
              </div>
              <div className="bg-green-50 p-3 rounded-lg border border-green-100">
                <div className="flex items-center font-semibold text-green-700 mb-1">
                  <Settings className="h-4 w-4 mr-2" />
                  Technicien
                </div>
                <p className="text-green-600">Gestion technique et réparations</p>
              </div>
              <div className="bg-purple-50 p-3 rounded-lg border border-purple-100">
                <div className="flex items-center font-semibold text-purple-700 mb-1">
                  <Briefcase className="h-4 w-4 mr-2" />
                  Directeur
                </div>
                <p className="text-purple-600">Tableaux de bord et rapports</p>
              </div>
            </div>
          </div>

          {/* Actions */}
          <div className="flex gap-3 pt-4 border-t border-base-300">
            <button
              type="button"
              onClick={handleClose}
              className="btn btn-outline flex-1 gap-2 text-base-content hover:bg-base-300"
            >
              <X className="h-4 w-4" />
              Annuler
            </button>
            <button
              type="submit"
              className="btn btn-primary flex-1 gap-2 text-white"
              disabled={
                (!profil && 
                  (!formData.username || 
                   !formData.email || 
                   !formData.password || 
                   formData.password !== formData.password_confirm ||
                   !formData.name ||
                   !formData.departement ||
                   !formData.role)) ||
                (!!profil && 
                  (!formData.departement || 
                   !formData.role))
              }
            >
              {profil ? (
                <>
                  <CheckCircle className="h-4 w-4" />
                  Modifier le profil
                </>
              ) : (
                <>
                  <UserPlus className="h-4 w-4" />
                  Créer l'utilisateur et le profil
                </>
              )}
            </button>
          </div>
        </form>
      </div>
    </div>
  );
};

export default ProfilUtilisateurForm;