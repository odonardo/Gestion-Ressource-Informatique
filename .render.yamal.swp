services:
  - type: web
    name: gestion-parc-informatique
    env: python
    buildCommand: |
      pip install -r backend/requirements.txt
      python backend/manage.py migrate
    startCommand: gunicorn backend.ton_projet.wsgi:application
    envVars:
      - key: DATABASE_URL
        fromDatabase:
          name: Gestion-Ressources-Informatiques  # remplace par le nom de ta DB
          property: connectionString

